// arcade_app.ailang — thin runner. Kernel owns the playfield.
// Host (Gtk) blits /dev/shm/arcade_app/frame0.raw or frame1.raw.
// gen.txt says which one is finished. The kernel fills the other.
// prof.txt is one timing line per second.
//
// Build: ailang.x arcade_app.ailang arcade_app.x
// Run:   ./scripts/run_arcade.sh
//
// Copyright © 2026 Sean Collins, 2 Paws Machine and Engineering. SCSL v1.0.

LibraryImport.Arena
LibraryImport.SVG
LibraryImport.Display.Render.Framebuffer
LibraryImport.Display.Render.VIF
LibraryImport.Display.Render.Fonts

Import.App.State
Import.App.World
Import.App.Ipc
Import.App.Prof
Import.App.Sfx
Import.App.Entity
Import.App.Blit
Import.App.Assets
Import.App.Formation
Import.App.Boom
Import.App.Star
Import.App.Hud
Import.App.Set
Import.App.Draw
Import.App.Cab
Import.Game.Paths
Import.Game.Gen
Import.Game.Galaga
Import.Game.Gyre

Function.DebugLog_Push {
    Input: tag: Address
    Input: n: Integer
    Output: Integer
    Body: { ReturnValue(0) }
}

SubRoutine.Main {
    PrintMessage("arcade: kernel /dev/shm/arcade_app (playfield = window)\n")
    Ipc_Ensure()
    Arena_Init()
    Data_Boot()
    Sfx_Init()
    Ipc_PollSize()
    IfCondition NotEqual(World.ok, 1) ThenBlock: {
        IfCondition EqualTo(World_SetSize(800, 600), Subtract(0, 1)) ThenBlock: {
            PrintMessage("FAIL fb\n")
            SystemCall(60, 1, 0, 0)
        }
    }
    Arc_Seed(Ipc_NowMs())
    Ent_Init()
    Form_Init()
    Gen_Init()
    Star_Init()
    Hud_Init()
    Gfx_Arm()
    Cab_Boot()
    Set_Load()
    Arcade.run = 1
    WhileLoop EqualTo(Arcade.run, 1) {
        t0 = Ipc_NowUs()
        IfCondition EqualTo(Prof.win, 0) ThenBlock: { Prof.win = t0 }
        Prof.mark = t0
        Ipc_PollSize()
        Prof_Lap(1)
        Cab_Resize()
        Prof_Lap(2)
        Ipc_PollKeys()
        hit = Ipc_PollCmd()
        Prof_Lap(1)
        IfCondition EqualTo(hit, 1) ThenBlock: { Arcade.run = 0 }
        IfCondition EqualTo(hit, 2) ThenBlock: {
            IfCondition EqualTo(Arcade.pause, 1) ThenBlock: {
                Set_Close()
            }
            ElseBlock: {
                Arcade.pause = 1
                Arcade.sel = 0
            }
        }
        IfCondition EqualTo(hit, 3) ThenBlock: {
            IfCondition EqualTo(Arcade.mode, Mode.TITLE) ThenBlock: { Cab_Start() }
            IfCondition EqualTo(Arcade.mode, Mode.PICK) ThenBlock: { Cab_Enter() }
        }
        IfCondition EqualTo(Arcade.run, 1) ThenBlock: {
            Arcade.t = Add(Arcade.t, 1)
            Prof_Mark()
            Star_Tick()
            Cab_Tick()
            Prof_Lap(3)
            Cab_Draw()
            Prof_Mark()
            Ipc_Present()
            Prof_Lap(8)
            Sfx_Flush()
            Prof_Lap(9)
            now = Ipc_NowUs()
            d = Subtract(now, t0)
            Prof_Note(11, d)
            Prof.frames = Add(Prof.frames, 1)
            dt = Divide(d, 1000)
            wait = Subtract(16, dt)
            IfCondition LessThan(wait, 1) ThenBlock: { wait = 1 }
            IfCondition GreaterThan(wait, 16) ThenBlock: { wait = 16 }
            Prof_Mark()
            Ipc_Sleep(wait)
            Prof_Lap(10)
            now = Ipc_NowUs()
            Prof_Flush(now)
        }
    }
    PrintMessage("arcade stop\n")
    SystemCall(60, 0, 0, 0)
}
RunTask(Main)
