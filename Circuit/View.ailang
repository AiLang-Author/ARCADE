// Circuit/View.ailang — draw one ingested level at the window's pixel size.
// The host already publishes device pixels, so a cell is the view fit to
// that window. Entity sheets are not map tiles. The character is drawn
// by Circuit/Body.ailang.
// Copyright (c) 2026 Sean Collins, 2 Paws Machine and Engineering. SCSL v1.0.

LibraryImport.Arena
LibraryImport.SVG
LibraryImport.Display.Render.Framebuffer
LibraryImport.Display.Render.VIF
LibraryImport.Display.Render.DSurface
LibraryImport.Browser.ImageDecode
Import.App.State
Import.App.World
Import.App.Blit

FixedPool.Cv {
    "live": Initialize=1, CanChange=True
    "tick": Initialize=0, CanChange=True
    "na": Initialize=0, CanChange=True
    "mapw": Initialize=1, CanChange=True
    "maph": Initialize=1, CanChange=True
    "vieww": Initialize=16, CanChange=True
    "viewh": Initialize=10, CanChange=True
    "grav": Initialize=30, CanChange=True
    "fall": Initialize=20, CanChange=True
    "spd": Initialize=8, CanChange=True
    "jmp": Initialize=14, CanChange=True
    "tile": Initialize=200, CanChange=True
    "camx": Initialize=0, CanChange=True
    "camy": Initialize=0, CanChange=True
    "px": Initialize=0, CanChange=True
    "ox": Initialize=0, CanChange=True
    "oy": Initialize=0, CanChange=True
    "names": Initialize=0, CanChange=True
    "paths": Initialize=0, CanChange=True
    "grp": Initialize=0, CanChange=True
    "fr": Initialize=0, CanChange=True
    "surf": Initialize=0, CanChange=True
    "grid": Initialize=0, CanChange=True
    "used": Initialize=0, CanChange=True
    "lpath": Initialize=0, CanChange=True
    "limg": Initialize=0, CanChange=True
    "nlayer": Initialize=0, CanChange=True
    "bsurf": Initialize=0, CanChange=True
    "brow": Initialize=0, CanChange=True
    "anim": Initialize=0, CanChange=True
    "lk": Initialize=0, CanChange=True
    "rk": Initialize=0, CanChange=True
    "uk": Initialize=0, CanChange=True
    "dk": Initialize=0, CanChange=True
    "ready": Initialize=0, CanChange=True
    "ri": Initialize=0, CanChange=True
    "imgio": Initialize=0, CanChange=True
    "msg": Initialize=0, CanChange=True
    "num": Initialize=0, CanChange=True
    "seq": Initialize=0, CanChange=True
    "pbuf": Initialize=0, CanChange=True
    "lsurf": Initialize=0, CanChange=True
    "bi": Initialize=0, CanChange=True
    "hidle": Initialize=-1, CanChange=True
    "hrun": Initialize=-1, CanChange=True
    "hjump": Initialize=-1, CanChange=True
    "hx": Initialize=0, CanChange=True
    "hy": Initialize=0, CanChange=True
    "vx": Initialize=0, CanChange=True
    "vy": Initialize=0, CanChange=True
    "ground": Initialize=1, CanChange=True
    "face": Initialize=0, CanChange=True
    "jumped": Initialize=0, CanChange=True
    "hh": Initialize=2, CanChange=True
    "hcol": Initialize=-1, CanChange=True
    "hrow": Initialize=-1, CanChange=True
    "flip": Initialize=0, CanChange=True
    "cx": Initialize=0, CanChange=True
    "cy": Initialize=0, CanChange=True
    "attr": Initialize=0, CanChange=True
    "boost": Initialize=0, CanChange=True
    "score": Initialize=0, CanChange=True
    "won": Initialize=0, CanChange=True
    "crumb": Initialize=0, CanChange=True
    "pain": Initialize=0, CanChange=True
    "sx0": Initialize=0, CanChange=True
    "sy0": Initialize=0, CanChange=True
    "mark": Initialize=-1, CanChange=True
