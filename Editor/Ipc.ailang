Function.Ed_Ensure {
    Output: Integer
    Body: {
        SystemCall(83, "/dev/shm", 493)
        SystemCall(83, "/dev/shm/level_edit", 493)
        ReturnValue(1)
    }
}

Function.Ed_Open {
    Input: kind: Integer
    Input: flags: Integer
    Input: mode: Integer
    Output: Integer
    Body: {
        fd = Subtract(0, 1)
        IfCondition EqualTo(kind, 1) ThenBlock: { fd = SystemCall(2, "/dev/shm/level_edit/meta.bin", flags, mode) }
        IfCondition EqualTo(kind, 2) ThenBlock: { fd = SystemCall(2, "/dev/shm/level_edit/frame.tmp", flags, mode) }
        IfCondition EqualTo(kind, 3) ThenBlock: { fd = SystemCall(2, "/dev/shm/level_edit/gen.tmp", flags, mode) }
        IfCondition EqualTo(kind, 4) ThenBlock: { fd = SystemCall(2, "/dev/shm/level_edit/size.txt", flags, mode) }
        IfCondition EqualTo(kind, 5) ThenBlock: { fd = SystemCall(2, "/dev/shm/level_edit/keys.txt", flags, mode) }
        IfCondition EqualTo(kind, 6) ThenBlock: { fd = SystemCall(2, "/dev/shm/level_edit/cmd.txt", flags, mode) }
        ReturnValue(fd)
    }
}

Function.Ed_Rename {
    Input: kind: Integer
    Body: {
        IfCondition EqualTo(kind, 0) ThenBlock: {
            SystemCall(82, "/dev/shm/level_edit/frame.tmp", "/dev/shm/level_edit/frame0.raw")
        }
        IfCondition EqualTo(kind, 1) ThenBlock: {
            SystemCall(82, "/dev/shm/level_edit/frame.tmp", "/dev/shm/level_edit/frame1.raw")
        }
        IfCondition EqualTo(kind, 2) ThenBlock: {
            SystemCall(82, "/dev/shm/level_edit/gen.tmp", "/dev/shm/level_edit/gen.txt")
        }
    }
}

Function.Ed_Sleep {
    Input: ms: Integer
    Body: {
        IfCondition EqualTo(Ipc.ts, 0) ThenBlock: { Ipc.ts = Allocate(16) }
        IfCondition LessThan(ms, 1) ThenBlock: { ms = 1 }
        StoreValue(Ipc.ts, Divide(ms, 1000))
        StoreValue(Add(Ipc.ts, 8), Multiply(Modulo(ms, 1000), 1000000))
        SystemCall(35, Ipc.ts, 0)
    }
}

Function.Ed_WriteAll {
    Input: fd: Integer
    Input: ptr: Address
    Input: n: Integer
    Output: Integer
    Body: {
        left = n
        at = ptr
        WhileLoop GreaterThan(left, 0) {
            got = SystemCall(1, fd, at, left)
            IfCondition LessEqual(got, 0) ThenBlock: { ReturnValue(0) }
            at = Add(at, got)
            left = Subtract(left, got)
        }
        ReturnValue(1)
    }
}

Function.Ed_Skip {
    Input: s: Address
    Input: off: Integer
    Output: Integer
    Body: {
        Ipc.i = off
        WhileLoop LessThan(Ipc.i, 96) {
            Ipc.c = GetByte(s, Ipc.i)
            IfCondition EqualTo(Ipc.c, 0) ThenBlock: { ReturnValue(Ipc.i) }
            IfCondition EqualTo(Ipc.c, 32) ThenBlock: { ReturnValue(Add(Ipc.i, 1)) }
            IfCondition EqualTo(Ipc.c, 10) ThenBlock: { ReturnValue(Ipc.i) }
            Ipc.i = Add(Ipc.i, 1)
        }
        ReturnValue(Ipc.i)
    }
}

Function.Ed_Present {
    Output: Integer
    Body: {
        back = 0
        wrote = 0
        Ed_Ensure()
        IfCondition EqualTo(Ipc.hdr, 0) ThenBlock: { Ipc.hdr = Allocate(16) }
        IfCondition EqualTo(Ipc.hdr, 0) ThenBlock: { ReturnValue(0) }
        Arc_LE32(Ipc.hdr, 0, FB.width)
        Arc_LE32(Ipc.hdr, 4, FB.height)
        Arc_LE32(Ipc.hdr, 8, FB.pitch)
        Ipc.fd = Ed_Open(1, 577, 420)
        IfCondition LessThan(Ipc.fd, 0) ThenBlock: { ReturnValue(0) }
        SystemCall(1, Ipc.fd, Ipc.hdr, 12)
        SystemCall(3, Ipc.fd)
        back = Subtract(1, Ed.pub)
        IfCondition NotEqual(back, 0) ThenBlock: {
            IfCondition NotEqual(back, 1) ThenBlock: { back = 0 }
        }
        Ipc.n = Multiply(FB.pitch, FB.height)
        Ipc.fd = Ed_Open(2, 577, 420)
        IfCondition LessThan(Ipc.fd, 0) ThenBlock: { ReturnValue(0) }
        wrote = Ed_WriteAll(Ipc.fd, FB_GetDrawBuffer(), Ipc.n)
        SystemCall(3, Ipc.fd)
        IfCondition EqualTo(wrote, 0) ThenBlock: { ReturnValue(0) }
        Ed_Rename(back)
        Ed.pub = back
        Ed.gen = Add(Ed.gen, 1)
        IfCondition LessThan(Ed.gen, 1) ThenBlock: { Ed.gen = 1 }
        IfCondition EqualTo(Ipc.genb, 0) ThenBlock: { Ipc.genb = Allocate(32) }
        IfCondition EqualTo(Ipc.genb, 0) ThenBlock: { ReturnValue(0) }
        Ipc.n = 0
        Ipc.i = Ed.gen
        WhileLoop GreaterThan(Ipc.i, 0) {
            SetByte(Add(Ipc.genb, 16), Ipc.n, Add(48, Modulo(Ipc.i, 10)))
            Ipc.n = Add(Ipc.n, 1)
            Ipc.i = Divide(Ipc.i, 10)
        }
        Ipc.w = 0
        WhileLoop LessThan(Ipc.w, Ipc.n) {
            SetByte(Ipc.genb, Ipc.w, GetByte(Add(Ipc.genb, 16), Subtract(Subtract(Ipc.n, 1), Ipc.w)))
            Ipc.w = Add(Ipc.w, 1)
        }
        SetByte(Ipc.genb, Ipc.n, 32)
        SetByte(Ipc.genb, Add(Ipc.n, 1), Add(48, Ed.pub))
        SetByte(Ipc.genb, Add(Ipc.n, 2), 10)
        Ipc.fd = Ed_Open(3, 577, 420)
        IfCondition LessThan(Ipc.fd, 0) ThenBlock: { ReturnValue(0) }
        SystemCall(1, Ipc.fd, Ipc.genb, Add(Ipc.n, 3))
        SystemCall(3, Ipc.fd)
        Ed_Rename(2)
        ReturnValue(1)
    }
}

Function.Ed_PollSize {
    Output: Integer
    Body: {
        IfCondition EqualTo(Ipc.size, 0) ThenBlock: { Ipc.size = Allocate(64) }
        Ipc.fd = Ed_Open(4, 0, 0)
        IfCondition LessThan(Ipc.fd, 0) ThenBlock: { ReturnValue(0) }
        Ipc.n = SystemCall(0, Ipc.fd, Ipc.size, 48)
        SystemCall(3, Ipc.fd)
        IfCondition LessEqual(Ipc.n, 0) ThenBlock: { ReturnValue(0) }
        SetByte(Ipc.size, Ipc.n, 0)
        Scratch.a = Arc_Atoi(Ipc.size)
        Ipc.i = Ed_Skip(Ipc.size, 0)
        Scratch.b = Arc_Atoi(Add(Ipc.size, Ipc.i))
        IfCondition LessThan(Scratch.a, 32) ThenBlock: { ReturnValue(0) }
        IfCondition LessThan(Scratch.b, 32) ThenBlock: { ReturnValue(0) }
        ReturnValue(World_SetSize(Scratch.a, Scratch.b))
    }
}

Function.Ed_PollKeys {
    Output: Integer
    Body: {
        IfCondition EqualTo(Ipc.keys, 0) ThenBlock: { Ipc.keys = Allocate(64) }
        Ipc.fd = Ed_Open(5, 0, 0)
        IfCondition LessThan(Ipc.fd, 0) ThenBlock: { ReturnValue(0) }
        Ipc.n = SystemCall(0, Ipc.fd, Ipc.keys, 48)
        SystemCall(3, Ipc.fd)
        IfCondition LessEqual(Ipc.n, 0) ThenBlock: { ReturnValue(0) }
        SetByte(Ipc.keys, Ipc.n, 0)
        Key.l = Arc_Atoi(Ipc.keys)
        Ipc.i = Ed_Skip(Ipc.keys, 0)
        Key.r = Arc_Atoi(Add(Ipc.keys, Ipc.i))
        Ipc.i = Ed_Skip(Ipc.keys, Ipc.i)
        Key.u = Arc_Atoi(Add(Ipc.keys, Ipc.i))
        Ipc.i = Ed_Skip(Ipc.keys, Ipc.i)
        Key.d = Arc_Atoi(Add(Ipc.keys, Ipc.i))
        Ipc.i = Ed_Skip(Ipc.keys, Ipc.i)
        Key.f = Arc_Atoi(Add(Ipc.keys, Ipc.i))
        Ipc.i = Ed_Skip(Ipc.keys, Ipc.i)
        Key.s = Arc_Atoi(Add(Ipc.keys, Ipc.i))
        Ipc.i = Ed_Skip(Ipc.keys, Ipc.i)
        Key.p = Arc_Atoi(Add(Ipc.keys, Ipc.i))
        Ipc.i = Ed_Skip(Ipc.keys, Ipc.i)
        EdKey.n = Arc_Atoi(Add(Ipc.keys, Ipc.i))
        ReturnValue(1)
    }
}

Function.Ed_PollCmd {
    Output: Integer
    Body: {
        IfCondition EqualTo(Ipc.cmd, 0) ThenBlock: { Ipc.cmd = Allocate(64) }
        Ipc.fd = Ed_Open(6, 0, 0)
        IfCondition LessThan(Ipc.fd, 0) ThenBlock: { ReturnValue(0) }
        Ipc.n = SystemCall(0, Ipc.fd, Ipc.cmd, 48)
        SystemCall(3, Ipc.fd)
        IfCondition LessEqual(Ipc.n, 0) ThenBlock: { ReturnValue(0) }
        Ipc.c = GetByte(Ipc.cmd, 0)
        Ipc.fd = Ed_Open(6, 577, 420)
        IfCondition GreaterEqual(Ipc.fd, 0) ThenBlock: { SystemCall(3, Ipc.fd) }
        IfCondition EqualTo(Ipc.c, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Ipc.c, 10) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Ipc.c, 113) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(Ipc.c, 81) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(Ipc.c, 114) ThenBlock: {
            Scratch.a = Arc_Atoi(Add(Ipc.cmd, 1))
            Ipc.i = Ed_Skip(Ipc.cmd, 1)
            Scratch.b = Arc_Atoi(Add(Ipc.cmd, Ipc.i))
            World_SetSize(Scratch.a, Scratch.b)
            ReturnValue(4)
        }
        ReturnValue(0)
    }
}
