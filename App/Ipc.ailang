// App/Ipc.ailang — CAD/Paint file protocol, /dev/shm/arcade_app.
// size.txt is the window. keys.txt is held keys. cmd.txt is quit/pause/start.
// Copyright © 2026 Sean Collins, 2 Paws Machine and Engineering. SCSL v1.0.

LibraryImport.Arena
LibraryImport.Display.Render.Framebuffer
Import.App.State
Import.App.World

Function.Ipc_Ensure {
    Output: Integer
    Body: {
        SystemCall(83, "/dev/shm", 493)
        SystemCall(83, "/dev/shm/arcade_app", 493)
        SystemCall(83, "/tmp/arcade_app", 493)
        ReturnValue(1)
    }
}

Function.Ipc_Open {
    Input: kind: Integer
    Input: flags: Integer
    Input: mode: Integer
    Output: Integer
    Body: {
        fd = Subtract(0, 1)
        IfCondition EqualTo(Ipc.tmp, 0) ThenBlock: {
            IfCondition EqualTo(kind, 1) ThenBlock: { fd = SystemCall(2, "/dev/shm/arcade_app/frame.raw", flags, mode) }
            IfCondition EqualTo(kind, 2) ThenBlock: { fd = SystemCall(2, "/dev/shm/arcade_app/meta.bin", flags, mode) }
            IfCondition EqualTo(kind, 3) ThenBlock: { fd = SystemCall(2, "/dev/shm/arcade_app/frame.tmp", flags, mode) }
            IfCondition EqualTo(kind, 4) ThenBlock: { fd = SystemCall(2, "/dev/shm/arcade_app/gen.tmp", flags, mode) }
            IfCondition EqualTo(kind, 5) ThenBlock: { fd = SystemCall(2, "/dev/shm/arcade_app/gen.txt", flags, mode) }
            IfCondition EqualTo(kind, 6) ThenBlock: { fd = SystemCall(2, "/dev/shm/arcade_app/size.txt", flags, mode) }
            IfCondition EqualTo(kind, 7) ThenBlock: { fd = SystemCall(2, "/dev/shm/arcade_app/keys.txt", flags, mode) }
            IfCondition EqualTo(kind, 8) ThenBlock: { fd = SystemCall(2, "/dev/shm/arcade_app/cmd.txt", flags, mode) }
            IfCondition EqualTo(kind, 9) ThenBlock: { fd = SystemCall(2, "/dev/shm/arcade_app/sfx.bin", flags, mode) }
            IfCondition EqualTo(kind, 10) ThenBlock: { fd = SystemCall(2, "/dev/shm/arcade_app/vol.txt", flags, mode) }
            IfCondition EqualTo(kind, 11) ThenBlock: { fd = SystemCall(2, "/dev/shm/arcade_app/frame0.raw", flags, mode) }
            IfCondition EqualTo(kind, 12) ThenBlock: { fd = SystemCall(2, "/dev/shm/arcade_app/frame1.raw", flags, mode) }
            IfCondition EqualTo(kind, 13) ThenBlock: { fd = SystemCall(2, "/dev/shm/arcade_app/prof.tmp", flags, mode) }
        }
        ElseBlock: {
            IfCondition EqualTo(kind, 1) ThenBlock: { fd = SystemCall(2, "/tmp/arcade_app/frame.raw", flags, mode) }
            IfCondition EqualTo(kind, 2) ThenBlock: { fd = SystemCall(2, "/tmp/arcade_app/meta.bin", flags, mode) }
            IfCondition EqualTo(kind, 3) ThenBlock: { fd = SystemCall(2, "/tmp/arcade_app/frame.tmp", flags, mode) }
            IfCondition EqualTo(kind, 4) ThenBlock: { fd = SystemCall(2, "/tmp/arcade_app/gen.tmp", flags, mode) }
            IfCondition EqualTo(kind, 5) ThenBlock: { fd = SystemCall(2, "/tmp/arcade_app/gen.txt", flags, mode) }
            IfCondition EqualTo(kind, 6) ThenBlock: { fd = SystemCall(2, "/tmp/arcade_app/size.txt", flags, mode) }
            IfCondition EqualTo(kind, 7) ThenBlock: { fd = SystemCall(2, "/tmp/arcade_app/keys.txt", flags, mode) }
            IfCondition EqualTo(kind, 8) ThenBlock: { fd = SystemCall(2, "/tmp/arcade_app/cmd.txt", flags, mode) }
            IfCondition EqualTo(kind, 9) ThenBlock: { fd = SystemCall(2, "/tmp/arcade_app/sfx.bin", flags, mode) }
            IfCondition EqualTo(kind, 10) ThenBlock: { fd = SystemCall(2, "/tmp/arcade_app/vol.txt", flags, mode) }
            IfCondition EqualTo(kind, 11) ThenBlock: { fd = SystemCall(2, "/tmp/arcade_app/frame0.raw", flags, mode) }
            IfCondition EqualTo(kind, 12) ThenBlock: { fd = SystemCall(2, "/tmp/arcade_app/frame1.raw", flags, mode) }
            IfCondition EqualTo(kind, 13) ThenBlock: { fd = SystemCall(2, "/tmp/arcade_app/prof.tmp", flags, mode) }
        }
        ReturnValue(fd)
    }
}

Function.Ipc_Rename {
    Input: kind: Integer
    Body: {
        IfCondition EqualTo(Ipc.tmp, 0) ThenBlock: {
            IfCondition EqualTo(kind, 1) ThenBlock: {
                SystemCall(82, "/dev/shm/arcade_app/frame.tmp", "/dev/shm/arcade_app/frame.raw")
            }
            IfCondition EqualTo(kind, 2) ThenBlock: {
                SystemCall(82, "/dev/shm/arcade_app/gen.tmp", "/dev/shm/arcade_app/gen.txt")
            }
            IfCondition EqualTo(kind, 11) ThenBlock: {
                SystemCall(82, "/dev/shm/arcade_app/frame.tmp", "/dev/shm/arcade_app/frame0.raw")
            }
            IfCondition EqualTo(kind, 12) ThenBlock: {
                SystemCall(82, "/dev/shm/arcade_app/frame.tmp", "/dev/shm/arcade_app/frame1.raw")
            }
            IfCondition EqualTo(kind, 13) ThenBlock: {
                SystemCall(82, "/dev/shm/arcade_app/prof.tmp", "/dev/shm/arcade_app/prof.txt")
            }
        }
        ElseBlock: {
            IfCondition EqualTo(kind, 1) ThenBlock: {
                SystemCall(82, "/tmp/arcade_app/frame.tmp", "/tmp/arcade_app/frame.raw")
            }
            IfCondition EqualTo(kind, 2) ThenBlock: {
                SystemCall(82, "/tmp/arcade_app/gen.tmp", "/tmp/arcade_app/gen.txt")
            }
            IfCondition EqualTo(kind, 11) ThenBlock: {
                SystemCall(82, "/tmp/arcade_app/frame.tmp", "/tmp/arcade_app/frame0.raw")
            }
            IfCondition EqualTo(kind, 12) ThenBlock: {
                SystemCall(82, "/tmp/arcade_app/frame.tmp", "/tmp/arcade_app/frame1.raw")
            }
            IfCondition EqualTo(kind, 13) ThenBlock: {
                SystemCall(82, "/tmp/arcade_app/prof.tmp", "/tmp/arcade_app/prof.txt")
            }
        }
    }
}

Function.Ipc_NowMs {
    Output: Integer
    Body: {
        IfCondition EqualTo(Ipc.ts, 0) ThenBlock: { Ipc.ts = Allocate(16) }
        SystemCall(228, 1, Ipc.ts)
        ReturnValue(Add(Multiply(Dereference(Ipc.ts), 1000), Divide(Dereference(Add(Ipc.ts, 8)), 1000000)))
    }
}

Function.Ipc_NowUs {
    Output: Integer
    Body: {
        sec = 0
        nsec = 0
        us = 0
        IfCondition EqualTo(Ipc.ts, 0) ThenBlock: { Ipc.ts = Allocate(16) }
        SystemCall(228, 1, Ipc.ts)
        sec = Dereference(Ipc.ts)
        nsec = Dereference(Add(Ipc.ts, 8))
        us = Multiply(sec, 1000000)
        us = Add(us, Divide(nsec, 1000))
        ReturnValue(us)
    }
}

Function.Ipc_Sleep {
    Input: ms: Integer
    Body: {
        IfCondition EqualTo(Ipc.ts, 0) ThenBlock: { Ipc.ts = Allocate(16) }
        IfCondition LessThan(ms, 1) ThenBlock: { ms = 1 }
        StoreValue(Ipc.ts, Divide(ms, 1000))
        StoreValue(Add(Ipc.ts, 8), Multiply(Modulo(ms, 1000), 1000000))
        SystemCall(35, Ipc.ts, 0)
    }
}

Function.Ipc_WriteAll {
    Input: fd: Integer
    Input: ptr: Address
    Input: n: Integer
    Output: Integer
    Body: {
        left = n
        at = ptr
        WhileLoop GreaterThan(left, 0) {
            got = SystemCall(1, fd, at, left)
            IfCondition LessEqual(got, 0) ThenBlock: { ReturnValue(0) }
            at = Add(at, got)
            left = Subtract(left, got)
        }
        ReturnValue(1)
    }
}

// The window reads the other slot. This map is the one being filled.
Function.Ipc_MapSlot {
    Input: slot: Integer
    Output: Integer
    Body: {
        need = Multiply(FB.pitch, FB.height)
        kind = 12
        IfCondition EqualTo(slot, 0) ThenBlock: { kind = 11 }
        IfCondition EqualTo(slot, 0) ThenBlock: {
            IfCondition And(GreaterThan(Ipc.map0, 4095), EqualTo(Ipc.sz0, need)) ThenBlock: {
                ReturnValue(Ipc.map0)
            }
            IfCondition GreaterThan(Ipc.map0, 4095) ThenBlock: {
                SystemCall(11, Ipc.map0, Ipc.sz0)
                Ipc.map0 = 0
            }
        }
        IfCondition EqualTo(slot, 1) ThenBlock: {
            IfCondition And(GreaterThan(Ipc.map1, 4095), EqualTo(Ipc.sz1, need)) ThenBlock: {
                ReturnValue(Ipc.map1)
            }
            IfCondition GreaterThan(Ipc.map1, 4095) ThenBlock: {
                SystemCall(11, Ipc.map1, Ipc.sz1)
                Ipc.map1 = 0
            }
        }
        Ipc.fd = Ipc_Open(kind, 66, 420)
        IfCondition LessThan(Ipc.fd, 0) ThenBlock: { ReturnValue(0) }
        SystemCall(77, Ipc.fd, need)
        mapped = SystemCall(9, 0, need, 3, 1, Ipc.fd, 0)
        SystemCall(3, Ipc.fd)
        IfCondition LessThan(mapped, 4096) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(slot, 0) ThenBlock: {
            Ipc.map0 = mapped
            Ipc.sz0 = need
        }
        IfCondition EqualTo(slot, 1) ThenBlock: {
            Ipc.map1 = mapped
            Ipc.sz1 = need
        }
        ReturnValue(mapped)
    }
}

Function.Ipc_Present {
    Output: Integer
    Body: {
        Ipc_Ensure()
        IfCondition EqualTo(Ipc.hdr, 0) ThenBlock: { Ipc.hdr = Allocate(16) }
        Arc_LE32(Ipc.hdr, 0, FB.width)
        Arc_LE32(Ipc.hdr, 4, FB.height)
        Arc_LE32(Ipc.hdr, 8, FB.pitch)
        Ipc.fd = Ipc_Open(2, 577, 420)
        IfCondition LessThan(Ipc.fd, 0) ThenBlock: {
            Ipc.tmp = 1
            Ipc.fd = Ipc_Open(2, 577, 420)
        }
        IfCondition LessThan(Ipc.fd, 0) ThenBlock: { ReturnValue(0) }
        SystemCall(1, Ipc.fd, Ipc.hdr, 12)
        SystemCall(3, Ipc.fd)
        back = Subtract(1, Ipc.pub)
        IfCondition NotEqual(back, 0) ThenBlock: {
            IfCondition NotEqual(back, 1) ThenBlock: { back = 0 }
        }
        Ipc.n = Multiply(FB.pitch, FB.height)
        mapped = Ipc_MapSlot(back)
        IfCondition GreaterThan(mapped, 4095) ThenBlock: {
            MemoryCopy(mapped, FB_GetDrawBuffer(), Ipc.n)
        }
        ElseBlock: {
            Ipc.fd = Ipc_Open(3, 577, 420)
            IfCondition LessThan(Ipc.fd, 0) ThenBlock: { ReturnValue(0) }
            wrote = Ipc_WriteAll(Ipc.fd, FB_GetDrawBuffer(), Ipc.n)
            SystemCall(3, Ipc.fd)
            IfCondition EqualTo(wrote, 0) ThenBlock: { ReturnValue(0) }
            rel = 12
            IfCondition EqualTo(back, 0) ThenBlock: { rel = 11 }
            Ipc_Rename(rel)
        }
        Ipc.pub = back
        Ipc.gen = Add(Ipc.gen, 1)
        IfCondition EqualTo(Ipc.genb, 0) ThenBlock: { Ipc.genb = Allocate(32) }
        Ipc.n = 0
        Ipc.i = Ipc.gen
        IfCondition LessThan(Ipc.i, 1) ThenBlock: { Ipc.i = 1 }
        WhileLoop GreaterThan(Ipc.i, 0) {
            SetByte(Add(Ipc.genb, 16), Ipc.n, Add(48, Modulo(Ipc.i, 10)))
            Ipc.n = Add(Ipc.n, 1)
            Ipc.i = Divide(Ipc.i, 10)
        }
        Ipc.w = 0
        WhileLoop LessThan(Ipc.w, Ipc.n) {
            SetByte(Ipc.genb, Ipc.w, GetByte(Add(Ipc.genb, 16), Subtract(Subtract(Ipc.n, 1), Ipc.w)))
            Ipc.w = Add(Ipc.w, 1)
        }
        SetByte(Ipc.genb, Ipc.n, 32)
        SetByte(Ipc.genb, Add(Ipc.n, 1), Add(48, Ipc.pub))
        SetByte(Ipc.genb, Add(Ipc.n, 2), 10)
        Ipc.fd = Ipc_Open(4, 577, 420)
        IfCondition LessThan(Ipc.fd, 0) ThenBlock: { ReturnValue(0) }
        SystemCall(1, Ipc.fd, Ipc.genb, Add(Ipc.n, 3))
        SystemCall(3, Ipc.fd)
        Ipc_Rename(2)
        ReturnValue(1)
    }
}

Function.Ipc_SkipNum {
    Input: s: Address
    Input: off: Integer
    Output: Integer
    Body: {
        Ipc.i = off
        WhileLoop LessThan(Ipc.i, 96) {
            Ipc.c = GetByte(s, Ipc.i)
            IfCondition EqualTo(Ipc.c, 0) ThenBlock: { ReturnValue(Ipc.i) }
            IfCondition EqualTo(Ipc.c, 32) ThenBlock: { ReturnValue(Add(Ipc.i, 1)) }
            IfCondition EqualTo(Ipc.c, 10) ThenBlock: { ReturnValue(Ipc.i) }
            Ipc.i = Add(Ipc.i, 1)
        }
        ReturnValue(Ipc.i)
    }
}

Function.Ipc_PollSize {
    Output: Integer
    Body: {
        IfCondition EqualTo(Ipc.size, 0) ThenBlock: { Ipc.size = Allocate(64) }
        Ipc.fd = Ipc_Open(6, 0, 0)
        IfCondition LessThan(Ipc.fd, 0) ThenBlock: { ReturnValue(0) }
        Ipc.n = SystemCall(0, Ipc.fd, Ipc.size, 48)
        SystemCall(3, Ipc.fd)
        IfCondition LessEqual(Ipc.n, 0) ThenBlock: { ReturnValue(0) }
        SetByte(Ipc.size, Ipc.n, 0)
        Scratch.a = Arc_Atoi(Ipc.size)
        Ipc.i = Ipc_SkipNum(Ipc.size, 0)
        Scratch.b = Arc_Atoi(Add(Ipc.size, Ipc.i))
        IfCondition LessThan(Scratch.a, 32) ThenBlock: { ReturnValue(0) }
        IfCondition LessThan(Scratch.b, 32) ThenBlock: { ReturnValue(0) }
        ReturnValue(World_SetSize(Scratch.a, Scratch.b))
    }
}

Function.Ipc_PollKeys {
    Output: Integer
    Body: {
        IfCondition EqualTo(Ipc.keys, 0) ThenBlock: { Ipc.keys = Allocate(64) }
        Ipc.fd = Ipc_Open(7, 0, 0)
        IfCondition LessThan(Ipc.fd, 0) ThenBlock: { ReturnValue(0) }
        Ipc.n = SystemCall(0, Ipc.fd, Ipc.keys, 48)
        SystemCall(3, Ipc.fd)
        IfCondition LessEqual(Ipc.n, 0) ThenBlock: { ReturnValue(0) }
        SetByte(Ipc.keys, Ipc.n, 0)
        Ipc.i = 0
        Key.l = Arc_Atoi(Ipc.keys)
        Ipc.i = Ipc_SkipNum(Ipc.keys, 0)
        Key.r = Arc_Atoi(Add(Ipc.keys, Ipc.i))
        Ipc.i = Ipc_SkipNum(Ipc.keys, Ipc.i)
        Key.u = Arc_Atoi(Add(Ipc.keys, Ipc.i))
        Ipc.i = Ipc_SkipNum(Ipc.keys, Ipc.i)
        Key.d = Arc_Atoi(Add(Ipc.keys, Ipc.i))
        Ipc.i = Ipc_SkipNum(Ipc.keys, Ipc.i)
        Key.f = Arc_Atoi(Add(Ipc.keys, Ipc.i))
        Ipc.i = Ipc_SkipNum(Ipc.keys, Ipc.i)
        Key.s = Arc_Atoi(Add(Ipc.keys, Ipc.i))
        Ipc.i = Ipc_SkipNum(Ipc.keys, Ipc.i)
        Key.p = Arc_Atoi(Add(Ipc.keys, Ipc.i))
        ReturnValue(1)
    }
}

Function.Ipc_PollCmd {
    Output: Integer
    Body: {
        IfCondition EqualTo(Ipc.cmd, 0) ThenBlock: { Ipc.cmd = Allocate(64) }
        Ipc.fd = Ipc_Open(8, 0, 0)
        IfCondition LessThan(Ipc.fd, 0) ThenBlock: { ReturnValue(0) }
        Ipc.n = SystemCall(0, Ipc.fd, Ipc.cmd, 48)
        SystemCall(3, Ipc.fd)
        IfCondition LessEqual(Ipc.n, 0) ThenBlock: { ReturnValue(0) }
        Ipc.c = GetByte(Ipc.cmd, 0)
        Ipc.fd = Ipc_Open(8, 577, 420)
        IfCondition GreaterEqual(Ipc.fd, 0) ThenBlock: { SystemCall(3, Ipc.fd) }
        IfCondition EqualTo(Ipc.c, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Ipc.c, 10) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Ipc.c, 113) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(Ipc.c, 81) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(Ipc.c, 112) ThenBlock: { ReturnValue(2) }
        IfCondition EqualTo(Ipc.c, 115) ThenBlock: { ReturnValue(3) }
        IfCondition EqualTo(Ipc.c, 114) ThenBlock: {
            Scratch.a = Arc_Atoi(Add(Ipc.cmd, 1))
            Ipc.i = Ipc_SkipNum(Ipc.cmd, 1)
            Scratch.b = Arc_Atoi(Add(Ipc.cmd, Ipc.i))
            World_SetSize(Scratch.a, Scratch.b)
            ReturnValue(4)
        }
        ReturnValue(0)
    }
}
