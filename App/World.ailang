// App/World.ailang — the window's short side is the 1024-unit playfield.
// One scale for X and Y, centered, so a ship stays square at any window size.
// Sprites are rasterized at that scale. The host copies the buffer 1:1.
// Copyright © 2026 Sean Collins, 2 Paws Machine and Engineering. SCSL v1.0.

LibraryImport.Arena
LibraryImport.Display.Render.DSurfaceTypes
LibraryImport.Display.Render.DSurface
LibraryImport.Display.Render.Framebuffer
Import.App.State

Function.World_BindFB {
    Output: Integer
    Body: {
        IfCondition EqualTo(World.surf, 0) ThenBlock: {
            World.surf = Allocate(SurfaceConst.HEADER_SIZE)
        }
        IfCondition EqualTo(World.surf, 0) ThenBlock: { ReturnValue(0) }
        buf = FB_GetDrawBuffer()
        IfCondition EqualTo(buf, 0) ThenBlock: { ReturnValue(0) }
        StoreValue(Add(World.surf, SurfaceFields.FORMAT), SurfaceFormat.PIXEL_32)
        StoreValue(Add(World.surf, SurfaceFields.WIDTH), FB.width)
        StoreValue(Add(World.surf, SurfaceFields.HEIGHT), FB.height)
        StoreValue(Add(World.surf, SurfaceFields.PITCH), FB.pitch)
        StoreValue(Add(World.surf, SurfaceFields.DATA), buf)
        StoreValue(Add(World.surf, SurfaceFields.DATA_SIZE), Multiply(FB.pitch, FB.height))
        World.fw = FB.width
        World.fh = FB.height
        ReturnValue(1)
    }
}

Function.World_CellOf {
    Input: fw: Integer
    Input: fh: Integer
    Output: Integer
    Body: {
        m = fw
        IfCondition GreaterThan(fh, 0) ThenBlock: {
            IfCondition LessThan(fh, m) ThenBlock: { m = fh }
        }
        // A craft is 56 units. Raster that many device pixels, rounded.
        half = Divide(World.UW, 2)
        c = Multiply(m, 56)
        c = Add(c, half)
        c = Divide(c, World.UW)
        IfCondition LessThan(c, 12) ThenBlock: { c = 12 }
        IfCondition GreaterThan(c, 256) ThenBlock: { c = 256 }
        ReturnValue(c)
    }
}

Function.World_Place {
    Body: {
        side = World.fw
        IfCondition GreaterThan(World.fh, 0) ThenBlock: {
            IfCondition LessThan(World.fh, side) ThenBlock: { side = World.fh }
        }
        IfCondition LessThan(side, 1) ThenBlock: { side = 1 }
        World.span = side
        World.ox = Divide(Subtract(World.fw, side), 2)
        World.oy = Divide(Subtract(World.fh, side), 2)
        World.cell = World_CellOf(side, side)
    }
}

Function.World_SetSize {
    Input: w: Integer
    Input: h: Integer
    Output: Integer
    Body: {
        IfCondition LessThan(w, 320) ThenBlock: { w = 320 }
        IfCondition LessThan(h, 240) ThenBlock: { h = 240 }
        IfCondition GreaterThan(w, 4096) ThenBlock: { w = 4096 }
        IfCondition GreaterThan(h, 4096) ThenBlock: { h = 4096 }
        IfCondition And(EqualTo(World.ok, 1), And(EqualTo(w, World.fw), EqualTo(h, World.fh))) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition EqualTo(World.ok, 1) ThenBlock: {
            IfCondition GreaterThan(FB.fb_ptr, 0) ThenBlock: {
                SystemCall(11, FB.fb_ptr, FB.size)
                FB.fb_ptr = 0
            }
            FB.initialized = 0
        }
        IfCondition EqualTo(FB_InitHeadless(w, h), 0) ThenBlock: { ReturnValue(-1) }
        IfCondition EqualTo(World_BindFB(), 0) ThenBlock: { ReturnValue(-1) }
        World_Place()
        World.ok = 1
        Arcade.need = 1
        ReturnValue(1)
    }
}

Function.World_DU {
    Input: u: Integer
    Output: Integer
    Body: {
        IfCondition LessEqual(World.UW, 0) ThenBlock: { ReturnValue(0) }
        base = World.span
        IfCondition LessEqual(base, 0) ThenBlock: { base = World.fw }
        half = Divide(World.UW, 2)
        prod = Multiply(u, base)
        IfCondition LessThan(u, 0) ThenBlock: {
            prod = Subtract(prod, half)
        }
        ElseBlock: {
            prod = Add(prod, half)
        }
        ReturnValue(Divide(prod, World.UW))
    }
}

Function.World_X {
    Input: u: Integer
    Output: Integer
    Body: {
        p = World_DU(u)
        ReturnValue(Add(World.ox, p))
    }
}

Function.World_Y {
    Input: u: Integer
    Output: Integer
    Body: {
        IfCondition LessEqual(World.UH, 0) ThenBlock: { ReturnValue(0) }
        p = World_DU(u)
        ReturnValue(Add(World.oy, p))
    }
}

Function.World_SX {
    Input: u: Integer
    Output: Integer
    Body: {
        ReturnValue(World_X(u))
    }
}

Function.World_SY {
    Input: u: Integer
    Output: Integer
    Body: {
        ReturnValue(World_Y(u))
    }
}
