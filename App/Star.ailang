LibraryImport.Arena
LibraryImport.Display.Render.Framebuffer
Import.App.State
Import.App.World
Import.App.Ring

FixedPool.Star {
    "base": Initialize=0, CanChange=True
    "n":    Initialize=96, CanChange=True
    "ok":   Initialize=0, CanChange=True
}

Function.Star_Get {
    Input: i: Integer
    Input: f: Integer
    Output: Integer
    Body: {
        ReturnValue(Dereference(Add(Star.base, Add(Multiply(i, 48), Multiply(f, 8)))))
    }
}

Function.Star_Set {
    Input: i: Integer
    Input: f: Integer
    Input: v: Integer
    Body: {
        StoreValue(Add(Star.base, Add(Multiply(i, 48), Multiply(f, 8))), v)
    }
}

Function.Star_Init {
    Output: Integer
    Body: {
        IfCondition EqualTo(Star.ok, 1) ThenBlock: { ReturnValue(1) }
        Star.base = Allocate(Multiply(Star.n, 48))
        IfCondition EqualTo(Star.base, 0) ThenBlock: { ReturnValue(0) }
        i = 0
        WhileLoop LessThan(i, Star.n) {
            Star_Set(i, 0, Modulo(Multiply(Add(i, 17), 73), World.UW))
            Star_Set(i, 1, Modulo(Multiply(Add(i, 5), 91), World.UH))
            layer = Modulo(i, 3)
            Star_Set(i, 2, Add(1, layer))
            Star_Set(i, 3, layer)
            Star_Set(i, 4, Modulo(Multiply(Add(i, 3), 37), 256))
            Star_Set(i, 5, Modulo(Multiply(Add(i, 11), 53), 240))
            i = Add(i, 1)
        }
        Star.ok = 1
        ReturnValue(1)
    }
}

Function.Star_Tick {
    Body: {
        IfCondition EqualTo(Star.ok, 0) ThenBlock: { ReturnValue(0) }
        i = 0
        WhileLoop LessThan(i, Star.n) {
            y = Add(Star_Get(i, 1), Add(1, Multiply(Star_Get(i, 2), 2)))
            IfCondition GreaterThan(y, World.UH) ThenBlock: { y = 0 }
            Star_Set(i, 1, y)
            i = Add(i, 1)
        }
    }
}

Function.Star_Draw {
    Body: {
        IfCondition EqualTo(Star.ok, 0) ThenBlock: { ReturnValue(0) }
        i = 0
        WhileLoop LessThan(i, Star.n) {
            layer = Star_Get(i, 3)
            col = Arc_RGBA(80, 90, 120)
            IfCondition EqualTo(layer, 1) ThenBlock: { col = Arc_RGBA(140, 160, 200) }
            IfCondition EqualTo(layer, 2) ThenBlock: { col = Arc_RGBA(230, 240, 255) }
            x = World_X(Star_Get(i, 0))
            y = World_Y(Star_Get(i, 1))
            FB_SetPixel(x, y, col)
            IfCondition GreaterThan(layer, 0) ThenBlock: {
                FB_SetPixel(Add(x, 1), y, col)
            }
            IfCondition EqualTo(layer, 2) ThenBlock: {
                FB_SetPixel(x, Add(y, 1), col)
            }
            i = Add(i, 1)
        }
    }
}

Function.Star_TubeTick {
    Body: {
        IfCondition EqualTo(Star.ok, 0) ThenBlock: { ReturnValue(0) }
        i = 0
        WhileLoop LessThan(i, Star.n) {
            depth = Star_Get(i, 5)
            spd = 1
            layer = Star_Get(i, 3)
            IfCondition EqualTo(layer, 2) ThenBlock: { spd = 2 }
            depth = Add(depth, spd)
            IfCondition GreaterThan(depth, 256) ThenBlock: {
                depth = Modulo(depth, 24)
                ang = Star_Get(i, 4)
                ang = Add(ang, 29)
                ang = Add(ang, Modulo(Arcade.t, 64))
                ang = Modulo(ang, 256)
                Star_Set(i, 4, ang)
            }
            Star_Set(i, 5, depth)
            i = Add(i, 1)
        }
    }
}

Function.Star_TubeCol {
    Input: layer: Integer
    Input: depth: Integer
    Output: Integer
    Body: {
        shade = depth
        r = 0
        g = 0
        b = 0
        col = 0
        IfCondition GreaterThan(shade, 220) ThenBlock: { shade = 220 }
        IfCondition LessThan(shade, 24) ThenBlock: { shade = 24 }
        r = Divide(shade, 4)
        g = Divide(shade, 3)
        b = Divide(shade, 2)
        IfCondition EqualTo(layer, 1) ThenBlock: {
            r = Divide(shade, 2)
            g = Divide(shade, 2)
            g = Add(g, 20)
            b = shade
        }
        IfCondition EqualTo(layer, 2) ThenBlock: {
            r = shade
            g = shade
            b = 240
        }
        col = Arc_RGBA(r, g, b)
        ReturnValue(col)
    }
}

Function.Star_TubeDot {
    Input: ang: Integer
    Input: depth: Integer
    Input: col: Integer
    Input: fat: Integer
    Body: {
        x = 0
        y = 0
        vx = 0
        vy = 0
        ax = 0
        ay = 0
        px = 0
        py = 0
        span = 0
        hx = 0
        hy = 0
        cx = 0
        cy = 0
        lim = 0
        IfCondition LessThan(depth, 4) ThenBlock: { ReturnValue(0) }
        IfCondition GreaterThan(depth, 256) ThenBlock: { depth = 256 }
        Ring_Place(ang, 256)
        vx = Subtract(Ring.x, 512)
        vy = Subtract(Ring.y, 512)
        ax = vx
        IfCondition LessThan(ax, 0) ThenBlock: { ax = Subtract(0, ax) }
        ay = vy
        IfCondition LessThan(ay, 0) ThenBlock: { ay = Subtract(0, ay) }
        span = World.span
        IfCondition LessThan(span, 1) ThenBlock: { span = World.fw }
        px = Multiply(vx, span)
        px = Divide(px, 1024)
        py = Multiply(vy, span)
        py = Divide(py, 1024)
        ax = px
        IfCondition LessThan(ax, 0) ThenBlock: { ax = Subtract(0, ax) }
        ay = py
        IfCondition LessThan(ay, 0) ThenBlock: { ay = Subtract(0, ay) }
        cx = Divide(World.fw, 2)
        cy = Divide(World.fh, 2)
        hx = cx
        hy = cy
        IfCondition LessThan(hx, 1) ThenBlock: { hx = 1 }
        IfCondition LessThan(hy, 1) ThenBlock: { hy = 1 }
        lim = 0
        IfCondition EqualTo(ax, 0) ThenBlock: { lim = 1 }
        IfCondition EqualTo(lim, 0) ThenBlock: {
            IfCondition LessEqual(Multiply(hx, ay), Multiply(hy, ax)) ThenBlock: { lim = 0 }
            IfCondition GreaterThan(Multiply(hx, ay), Multiply(hy, ax)) ThenBlock: { lim = 1 }
        }
        IfCondition EqualTo(lim, 0) ThenBlock: {
            x = Multiply(px, depth)
            x = Multiply(x, hx)
            x = Divide(x, ax)
            x = Divide(x, 256)
            x = Add(cx, x)
            y = Multiply(py, depth)
            y = Multiply(y, hx)
            y = Divide(y, ax)
            y = Divide(y, 256)
            y = Add(cy, y)
        }
        IfCondition EqualTo(lim, 1) ThenBlock: {
            IfCondition LessThan(ay, 1) ThenBlock: { ay = 1 }
            x = Multiply(px, depth)
            x = Multiply(x, hy)
            x = Divide(x, ay)
            x = Divide(x, 256)
            x = Add(cx, x)
            y = Multiply(py, depth)
            y = Multiply(y, hy)
            y = Divide(y, ay)
            y = Divide(y, 256)
            y = Add(cy, y)
        }
        FB_SetPixel(x, y, col)
        IfCondition GreaterThan(fat, 0) ThenBlock: {
            FB_SetPixel(Add(x, 1), y, col)
        }
    }
}

Function.Star_TubeDraw {
    Body: {
        IfCondition EqualTo(Star.ok, 0) ThenBlock: { ReturnValue(0) }
        i = 0
        WhileLoop LessThan(i, Star.n) {
            ang = Star_Get(i, 4)
            depth = Star_Get(i, 5)
            layer = Star_Get(i, 3)
            col = Star_TubeCol(layer, depth)
            back = 0
            dim = 0
            fat = 0
            k = 0
            IfCondition GreaterThan(layer, 0) ThenBlock: { fat = 1 }
            WhileLoop LessThan(k, 4) {
                back = Multiply(Add(k, 1), 8)
                back = Subtract(depth, back)
                dim = Star_TubeCol(0, back)
                Star_TubeDot(ang, back, dim, 0)
                k = Add(k, 1)
            }
            Star_TubeDot(ang, depth, col, fat)
            i = Add(i, 1)
        }
    }
}
