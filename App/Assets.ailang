// App/Assets.ailang — SVG/TVG on demand at the current window cell size.
// Five-view strips (front back top bottom side). Procedural fallback if a
// vector file is missing so the engine always has something to blit.
// Copyright © 2026 Sean Collins, 2 Paws Machine and Engineering. SCSL v1.0.

LibraryImport.Arena
LibraryImport.SVG
LibraryImport.Display.Render.DSurfaceTypes
LibraryImport.Display.Render.DSurface
LibraryImport.Display.Render.DDrawPixel
LibraryImport.Display.Render.VIF
LibraryImport.Display.Render.StyleRaster
Import.App.State
Import.App.World
Import.App.Entity
Import.App.Formation

FixedPool.Gfx {
    "ok":     Initialize=0, CanChange=True
    "cell":   Initialize=0, CanChange=True
    "player": Initialize=0, CanChange=True
    "bee":    Initialize=0, CanChange=True
    "butter": Initialize=0, CanChange=True
    "boss":   Initialize=0, CanChange=True
    "scout":  Initialize=0, CanChange=True
    "dart":   Initialize=0, CanChange=True
    "heavy":  Initialize=0, CanChange=True
    "flag":   Initialize=0, CanChange=True
    "cap":    Initialize=0, CanChange=True
    "gate":   Initialize=0, CanChange=True
    "pshot":  Initialize=0, CanChange=True
    "eshot":  Initialize=0, CanChange=True
    "boom0":  Initialize=0, CanChange=True
    "boom1":  Initialize=0, CanChange=True
    "boom2":  Initialize=0, CanChange=True
    "boom3":  Initialize=0, CanChange=True
    "thrust": Initialize=0, CanChange=True
    "queen":  Initialize=0, CanChange=True
    "part":   Initialize=0, CanChange=True
}

// Rendered sprite sheets. One entry is path + pixel size + bitmap.
// The frame loop never rasterizes a sheet that is already here.
FixedPool.Sheet {
    "n":     Initialize=0, CanChange=True
    "base":  Initialize=0, CanChange=True
    "ready": Initialize=0, CanChange=True
}

Function.Gfx_Drop {
    Input: surf: Integer
    Output: Integer
    Body: {
        IfCondition NotEqual(surf, 0) ThenBlock: {
            Surface_Destroy(surf)
        }
        ReturnValue(0)
    }
}

Function.Data_HasPlayer {
    Output: Integer
    Body: {
        fd = SystemCall(2, "assets/ships/player.svg", 0, 0)
        IfCondition LessThan(fd, 0) ThenBlock: { ReturnValue(0) }
        SystemCall(3, fd)
        ReturnValue(1)
    }
}

Function.Data_StripFile {
    Input: p: Address
    Output: Integer
    Body: {
        n = 0
        last = Subtract(0, 1)
        more = 1
        WhileLoop EqualTo(more, 1) {
            c = GetByte(p, n)
            IfCondition EqualTo(c, 0) ThenBlock: { more = 0 }
            IfCondition EqualTo(more, 1) ThenBlock: {
                IfCondition EqualTo(c, 47) ThenBlock: { last = n }
                n = Add(n, 1)
            }
        }
        IfCondition LessThan(last, 1) ThenBlock: { ReturnValue(0) }
        SetByte(p, last, 0)
        ReturnValue(1)
    }
}

// Assets live next to arcade_app.x. Do not depend on the launcher cwd.
Function.Data_Boot {
    Output: Integer
    Body: {
        hit = Data_HasPlayer()
        IfCondition EqualTo(hit, 1) ThenBlock: {
            PrintMessage("arcade: data cwd\n")
            ReturnValue(1)
        }
        buf = Allocate(512)
        IfCondition EqualTo(buf, 0) ThenBlock: {
            PrintMessage("arcade: WARN data buf\n")
            ReturnValue(0)
        }
        i = 0
        WhileLoop LessThan(i, 512) {
            SetByte(buf, i, 0)
            i = Add(i, 1)
        }
        n = SystemCall(89, "/proc/self/exe", buf, 511)
        IfCondition GreaterThan(n, 0) ThenBlock: {
            SetByte(buf, n, 0)
            cut = Data_StripFile(buf)
            IfCondition EqualTo(cut, 1) ThenBlock: {
                SystemCall(80, buf)
            }
        }
        hit = Data_HasPlayer()
        IfCondition EqualTo(hit, 1) ThenBlock: {
            PrintMessage("arcade: data next to arcade_app.x\n")
            ReturnValue(1)
        }
        SystemCall(80, "/boot/home/config/non-packaged/data/ailang_arcade")
        hit = Data_HasPlayer()
        IfCondition EqualTo(hit, 1) ThenBlock: {
            PrintMessage("arcade: data haiku datadir\n")
            ReturnValue(1)
        }
        PrintMessage("arcade: WARN no assets/ships/player.svg\n")
        ReturnValue(0)
    }
}

Function.Gfx_SamePath {
    Input: a: Address
    Input: b: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(a, b) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(a, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(b, 0) ThenBlock: { ReturnValue(0) }
        i = 0
        WhileLoop LessThan(i, 240) {
            ca = GetByte(a, i)
            cb = GetByte(b, i)
            IfCondition NotEqual(ca, cb) ThenBlock: { ReturnValue(0) }
            IfCondition EqualTo(ca, 0) ThenBlock: { ReturnValue(1) }
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

Function.Gfx_FindSheet {
    Input: path: Address
    Input: w: Integer
    Input: h: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(Sheet.base, 0) ThenBlock: { ReturnValue(0) }
        i = 0
        WhileLoop LessThan(i, Sheet.n) {
            rec = Add(Sheet.base, Multiply(i, 32))
            same = Gfx_SamePath(Dereference(rec), path)
            IfCondition EqualTo(same, 1) ThenBlock: {
                ww = Dereference(Add(rec, 8))
                hh = Dereference(Add(rec, 16))
                IfCondition EqualTo(ww, w) ThenBlock: {
                    IfCondition EqualTo(hh, h) ThenBlock: {
                        ReturnValue(Dereference(Add(rec, 24)))
                    }
                }
            }
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

Function.Gfx_Crisp {
    Input: surf: Integer
    Body: {
        IfCondition EqualTo(surf, 0) ThenBlock: { ReturnValue(0) }
        data = Surface_GetData(surf)
        IfCondition EqualTo(data, 0) ThenBlock: { ReturnValue(0) }
        sw = Surface_GetWidth(surf)
        sh = Surface_GetHeight(surf)
        sp = Surface_GetPitch(surf)
        y = 0
        WhileLoop LessThan(y, sh) {
            row = Multiply(y, sp)
            row = Add(data, row)
            x = 0
            WhileLoop LessThan(x, sw) {
                off = Multiply(x, 4)
                ao = Add(off, 3)
                a = GetByte(row, ao)
                IfCondition GreaterEqual(a, 128) ThenBlock: {
                    IfCondition NotEqual(a, 255) ThenBlock: {
                        SetByte(row, ao, 255)
                    }
                }
                ElseBlock: {
                    IfCondition GreaterThan(a, 0) ThenBlock: {
                        SetByte(row, off, 0)
                        SetByte(row, Add(off, 1), 0)
                        SetByte(row, Add(off, 2), 0)
                        SetByte(row, ao, 0)
                    }
                }
                x = Add(x, 1)
            }
            y = Add(y, 1)
        }
        ReturnValue(surf)
    }
}

Function.Gfx_KeepSheet {
    Input: path: Address
    Input: w: Integer
    Input: h: Integer
    Input: surf: Integer
    Output: Integer
    Body: {
        Gfx_Crisp(surf)
        IfCondition EqualTo(surf, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(path, 0) ThenBlock: { ReturnValue(surf) }
        hit = Gfx_FindSheet(path, w, h)
        IfCondition NotEqual(hit, 0) ThenBlock: { ReturnValue(hit) }
        IfCondition EqualTo(Sheet.base, 0) ThenBlock: {
            Sheet.base = Allocate(65536)
        }
        IfCondition EqualTo(Sheet.base, 0) ThenBlock: { ReturnValue(surf) }
        IfCondition GreaterEqual(Sheet.n, 2048) ThenBlock: { ReturnValue(surf) }
        rec = Add(Sheet.base, Multiply(Sheet.n, 32))
        StoreValue(rec, path)
        StoreValue(Add(rec, 8), w)
        StoreValue(Add(rec, 16), h)
        StoreValue(Add(rec, 24), surf)
        Sheet.n = Add(Sheet.n, 1)
        ReturnValue(surf)
    }
}

Function.Gfx_TryLoad {
    Input: svg: Address
    Input: tvg: Address
    Input: w: Integer
    Input: h: Integer
    Output: Integer
    Body: {
        surf = 0
        IfCondition NotEqual(svg, 0) ThenBlock: {
            surf = Gfx_FindSheet(svg, w, h)
            IfCondition NotEqual(surf, 0) ThenBlock: { ReturnValue(surf) }
            surf = SVG_RasterFile(svg, w, h)
            IfCondition NotEqual(surf, 0) ThenBlock: {
                Gfx_KeepSheet(svg, w, h, surf)
                ReturnValue(surf)
            }
        }
        IfCondition NotEqual(tvg, 0) ThenBlock: {
            surf = Gfx_FindSheet(tvg, w, h)
            IfCondition NotEqual(surf, 0) ThenBlock: { ReturnValue(surf) }
            surf = TVG_RenderFile(tvg, h)
            IfCondition NotEqual(surf, 0) ThenBlock: {
                Gfx_KeepSheet(tvg, w, h, surf)
                ReturnValue(surf)
            }
        }
        IfCondition NotEqual(svg, 0) ThenBlock: {
            PrintMessage("[Gfx] miss ")
            PrintMessage(svg)
            PrintMessage("\n")
        }
        ReturnValue(0)
    }
}

// fb is the procedural stand-in: 0-8 craft, 10-13 boom, 20-21 shot, -1 none.
Function.Gfx_Sheet {
    Input: svg: Address
    Input: tvg: Address
    Input: w: Integer
    Input: h: Integer
    Input: fb: Integer
    Output: Integer
    Body: {
        surf = Gfx_TryLoad(svg, tvg, w, h)
        IfCondition NotEqual(surf, 0) ThenBlock: { ReturnValue(surf) }
        IfCondition LessThan(fb, 0) ThenBlock: { ReturnValue(0) }
        IfCondition LessThan(fb, 9) ThenBlock: {
            surf = Gfx_BuildCraft(fb, h)
        }
        IfCondition EqualTo(surf, 0) ThenBlock: {
            IfCondition GreaterEqual(fb, 10) ThenBlock: {
                IfCondition LessThan(fb, 14) ThenBlock: {
                    surf = Gfx_BuildBoom(Subtract(fb, 10), h)
                }
            }
        }
        IfCondition EqualTo(surf, 0) ThenBlock: {
            IfCondition GreaterEqual(fb, 20) ThenBlock: {
                IfCondition LessThan(fb, 22) ThenBlock: {
                    surf = Gfx_BuildShot(Subtract(fb, 20), h)
                }
            }
        }
        IfCondition NotEqual(surf, 0) ThenBlock: {
            Gfx_KeepSheet(svg, w, h, surf)
        }
        ReturnValue(surf)
    }
}

Function.Gfx_NewStrip {
    Input: cols: Integer
    Input: cell: Integer
    Output: Integer
    Body: {
        IfCondition LessThan(cols, 1) ThenBlock: { cols = 1 }
        surf = Surface_Create(SurfaceFormat.PIXEL_32, Multiply(cols, cell), cell)
        IfCondition EqualTo(surf, 0) ThenBlock: { ReturnValue(0) }
        Draw_Pix_FillRect(surf, 0, 0, Multiply(cols, cell), cell, 0)
        ReturnValue(surf)
    }
}

Function.Gfx_Box {
    Input: surf: Integer
    Input: x: Integer
    Input: y: Integer
    Input: w: Integer
    Input: h: Integer
    Input: col: Integer
    Body: {
        IfCondition LessThan(w, 1) ThenBlock: { ReturnValue(0) }
        IfCondition LessThan(h, 1) ThenBlock: { ReturnValue(0) }
        Draw_Pix_FillRect(surf, x, y, w, h, col)
    }
}

Function.Gfx_Craft {
    Input: surf: Integer
    Input: ox: Integer
    Input: cell: Integer
    Input: view: Integer
    Input: pal: Integer
    Body: {
        c = cell
        s = Divide(c, 16)
        IfCondition LessThan(s, 1) ThenBlock: { s = 1 }
        body = Arc_RGBA(230, 235, 245)
        wing = Arc_RGBA(40, 90, 210)
        nose = Arc_RGBA(220, 50, 60)
        glow = Arc_RGBA(80, 200, 255)
        IfCondition EqualTo(pal, 1) ThenBlock: {
            body = Arc_RGBA(250, 210, 40)
            wing = Arc_RGBA(30, 70, 180)
            nose = Arc_RGBA(40, 50, 90)
            glow = Arc_RGBA(255, 240, 120)
        }
        IfCondition EqualTo(pal, 2) ThenBlock: {
            body = Arc_RGBA(230, 50, 70)
            wing = Arc_RGBA(250, 250, 255)
            nose = Arc_RGBA(40, 40, 80)
            glow = Arc_RGBA(255, 160, 80)
        }
        IfCondition EqualTo(pal, 3) ThenBlock: {
            body = Arc_RGBA(40, 180, 90)
            wing = Arc_RGBA(50, 90, 200)
            nose = Arc_RGBA(240, 220, 70)
            glow = Arc_RGBA(120, 255, 180)
        }
        IfCondition EqualTo(pal, 4) ThenBlock: {
            body = Arc_RGBA(80, 230, 230)
            wing = Arc_RGBA(20, 120, 160)
            nose = Arc_RGBA(255, 255, 255)
            glow = Arc_RGBA(180, 255, 255)
        }
        IfCondition EqualTo(pal, 5) ThenBlock: {
            body = Arc_RGBA(255, 140, 40)
            wing = Arc_RGBA(80, 30, 20)
            nose = Arc_RGBA(255, 230, 80)
            glow = Arc_RGBA(255, 80, 40)
        }
        IfCondition EqualTo(pal, 6) ThenBlock: {
            body = Arc_RGBA(150, 70, 210)
            wing = Arc_RGBA(60, 30, 110)
            nose = Arc_RGBA(255, 200, 80)
            glow = Arc_RGBA(220, 120, 255)
        }
        IfCondition EqualTo(pal, 7) ThenBlock: {
            body = Arc_RGBA(240, 190, 50)
            wing = Arc_RGBA(180, 40, 40)
            nose = Arc_RGBA(255, 255, 220)
            glow = Arc_RGBA(255, 80, 80)
        }
        IfCondition EqualTo(pal, 8) ThenBlock: {
            body = Arc_RGBA(26, 138, 106)
            wing = Arc_RGBA(13, 64, 48)
            nose = Arc_RGBA(255, 48, 64)
            glow = Arc_RGBA(255, 32, 56)
        }
        // top (classic) and default
        Gfx_Box(surf, Add(ox, Multiply(s, 6)), Multiply(s, 2), Multiply(s, 4), Multiply(s, 12), body)
        Gfx_Box(surf, Add(ox, Multiply(s, 2)), Multiply(s, 6), Multiply(s, 12), Multiply(s, 4), wing)
        Gfx_Box(surf, Add(ox, Multiply(s, 7)), Multiply(s, 1), Multiply(s, 2), Multiply(s, 3), nose)
        Gfx_Box(surf, Add(ox, Multiply(s, 7)), Multiply(s, 5), Multiply(s, 2), Multiply(s, 3), glow)
        IfCondition EqualTo(view, View.FRONT) ThenBlock: {
            Gfx_Box(surf, Add(ox, Multiply(s, 4)), Multiply(s, 4), Multiply(s, 8), Multiply(s, 8), body)
            Gfx_Box(surf, Add(ox, Multiply(s, 1)), Multiply(s, 7), Multiply(s, 14), Multiply(s, 3), wing)
            Gfx_Box(surf, Add(ox, Multiply(s, 6)), Multiply(s, 2), Multiply(s, 4), Multiply(s, 3), glow)
        }
        IfCondition EqualTo(view, View.BACK) ThenBlock: {
            Gfx_Box(surf, Add(ox, Multiply(s, 5)), Multiply(s, 4), Multiply(s, 6), Multiply(s, 8), body)
            Gfx_Box(surf, Add(ox, Multiply(s, 2)), Multiply(s, 10), Multiply(s, 3), Multiply(s, 4), nose)
            Gfx_Box(surf, Add(ox, Multiply(s, 11)), Multiply(s, 10), Multiply(s, 3), Multiply(s, 4), nose)
        }
        IfCondition EqualTo(view, View.SIDE) ThenBlock: {
            Gfx_Box(surf, Add(ox, Multiply(s, 3)), Multiply(s, 6), Multiply(s, 11), Multiply(s, 4), body)
            Gfx_Box(surf, Add(ox, Multiply(s, 12)), Multiply(s, 5), Multiply(s, 3), Multiply(s, 3), nose)
            Gfx_Box(surf, Add(ox, Multiply(s, 4)), Multiply(s, 9), Multiply(s, 6), Multiply(s, 3), wing)
        }
        IfCondition EqualTo(view, View.BOTTOM) ThenBlock: {
            Gfx_Box(surf, Add(ox, Multiply(s, 6)), Multiply(s, 3), Multiply(s, 4), Multiply(s, 10), Arc_RGBA(40, 45, 60))
            Gfx_Box(surf, Add(ox, Multiply(s, 3)), Multiply(s, 7), Multiply(s, 10), Multiply(s, 3), wing)
        }
        IfCondition Or(EqualTo(pal, 3), EqualTo(pal, 7)) ThenBlock: {
            Gfx_Box(surf, Add(ox, Multiply(s, 1)), Multiply(s, 4), Multiply(s, 3), Multiply(s, 8), wing)
            Gfx_Box(surf, Add(ox, Multiply(s, 12)), Multiply(s, 4), Multiply(s, 3), Multiply(s, 8), wing)
        }
        IfCondition EqualTo(pal, 6) ThenBlock: {
            Gfx_Box(surf, Add(ox, Multiply(s, 3)), Multiply(s, 10), Multiply(s, 10), Multiply(s, 4), body)
        }
    }
}

Function.Gfx_BuildCraft {
    Input: pal: Integer
    Input: cell: Integer
    Output: Integer
    Body: {
        surf = Gfx_NewStrip(5, cell)
        IfCondition EqualTo(surf, 0) ThenBlock: { ReturnValue(0) }
        v = 0
        WhileLoop LessThan(v, 5) {
            Gfx_Craft(surf, Multiply(v, cell), cell, v, pal)
            v = Add(v, 1)
        }
        ReturnValue(surf)
    }
}

Function.Gfx_BuildShot {
    Input: pal: Integer
    Input: cell: Integer
    Output: Integer
    Body: {
        surf = Gfx_NewStrip(1, cell)
        IfCondition EqualTo(surf, 0) ThenBlock: { ReturnValue(0) }
        s = Divide(cell, 16)
        IfCondition LessThan(s, 1) ThenBlock: { s = 1 }
        col = Arc_RGBA(255, 240, 80)
        IfCondition EqualTo(pal, 1) ThenBlock: { col = Arc_RGBA(255, 80, 120) }
        Gfx_Box(surf, Multiply(s, 7), Multiply(s, 2), Multiply(s, 2), Multiply(s, 12), col)
        Gfx_Box(surf, Multiply(s, 6), Multiply(s, 3), Multiply(s, 4), Multiply(s, 4), Arc_RGBA(255, 255, 255))
        ReturnValue(surf)
    }
}

Function.Gfx_BuildBoom {
    Input: style: Integer
    Input: cell: Integer
    Output: Integer
    Body: {
        surf = Gfx_NewStrip(8, cell)
        IfCondition EqualTo(surf, 0) ThenBlock: { ReturnValue(0) }
        f = 0
        WhileLoop LessThan(f, 8) {
            ox = Multiply(f, cell)
            cx = Add(ox, Divide(cell, 2))
            cy = Divide(cell, 2)
            r = Add(2, Multiply(Add(f, 1), Divide(cell, 10)))
            col = Arc_RGBA(255, 220, 80)
            IfCondition EqualTo(style, 0) ThenBlock: {
                IfCondition GreaterThan(f, 3) ThenBlock: { col = Arc_RGBA(255, 120, 40) }
                IfCondition GreaterThan(f, 6) ThenBlock: { col = Arc_RGBA(180, 40, 20) }
                Gfx_Box(surf, Subtract(cx, r), Subtract(cy, r), Multiply(r, 2), Multiply(r, 2), col)
                Gfx_Box(surf, Subtract(cx, Divide(r, 2)), Subtract(cy, Divide(r, 2)), r, r, Arc_RGBA(255, 200, 80))
                Gfx_Box(surf, Subtract(cx, Divide(r, 3)), Subtract(cy, Divide(r, 3)), Divide(Multiply(r, 2), 3), Divide(Multiply(r, 2), 3), Arc_RGBA(255, 255, 255))
                Gfx_Box(surf, Subtract(cx, 1), Subtract(cy, Multiply(r, 2)), 2, Multiply(r, 4), Arc_RGBA(255, 180, 60))
                Gfx_Box(surf, Subtract(cx, Multiply(r, 2)), Subtract(cy, 1), Multiply(r, 4), 2, Arc_RGBA(255, 180, 60))
            }
            IfCondition EqualTo(style, 1) ThenBlock: {
                col = Arc_RGBA(80, 180, 255)
                IfCondition GreaterThan(f, 4) ThenBlock: { col = Arc_RGBA(40, 80, 180) }
                Gfx_Box(surf, Subtract(cx, r), Subtract(cy, Divide(cell, 16)), Multiply(r, 2), Divide(cell, 8), col)
                Gfx_Box(surf, Subtract(cx, Divide(cell, 16)), Subtract(cy, r), Divide(cell, 8), Multiply(r, 2), col)
            }
            IfCondition EqualTo(style, 2) ThenBlock: {
                k = 0
                WhileLoop LessThan(k, Add(3, f)) {
                    dx = Multiply(Subtract(Modulo(Add(k, f), 7), 3), Divide(cell, 8))
                    dy = Multiply(Subtract(Modulo(Add(k, Multiply(f, 3)), 7), 3), Divide(cell, 8))
                    Gfx_Box(surf, Add(cx, dx), Add(cy, dy), Add(2, Divide(cell, 16)), Add(2, Divide(cell, 16)), Arc_RGBA(255, Subtract(200, Multiply(f, 20)), 40))
                    k = Add(k, 1)
                }
            }
            IfCondition EqualTo(style, 3) ThenBlock: {
                a = Subtract(255, Multiply(f, 28))
                IfCondition LessThan(a, 40) ThenBlock: { a = 40 }
                col = BitwiseOr(FB_RGB(255, a, Divide(a, 2)), ShiftLeft(a, 24))
                Gfx_Box(surf, Subtract(cx, r), Subtract(cy, r), Multiply(r, 2), Multiply(r, 2), col)
            }
            f = Add(f, 1)
        }
        ReturnValue(surf)
    }
}

Function.Gfx_Take {
    Input: svg: Address
    Input: tvg: Address
    Input: cols: Integer
    Input: cell: Integer
    Input: fallback: Integer
    Output: Integer
    Body: {
        surf = Gfx_TryLoad(svg, tvg, Multiply(cols, cell), cell)
        IfCondition NotEqual(surf, 0) ThenBlock: { ReturnValue(surf) }
        ReturnValue(fallback)
    }
}

Function.Gfx_Arm {
    Body: {
        IfCondition EqualTo(Sheet.ready, 1) ThenBlock: { ReturnValue(0) }
        SVG_Init()
        VIF_Init()
        Sheet.ready = 1
    }
}

Function.Gfx_Reload {
    Output: Integer
    Body: {
        cell = World.cell
        IfCondition LessThan(cell, 12) ThenBlock: { cell = 12 }
        IfCondition And(EqualTo(Gfx.ok, 1), EqualTo(Gfx.cell, cell)) ThenBlock: {
            ReturnValue(0)
        }
        Gfx_Arm()
        wide = Multiply(5, cell)
        Gfx.player = Gfx_Sheet("assets/ships/player.svg", "assets/ships/player.tvg", wide, cell, 0)
        Gfx.bee = Gfx_Sheet("assets/enemies/bee.svg", "assets/enemies/bee.tvg", wide, cell, 1)
        Gfx.butter = Gfx_Sheet("assets/enemies/butterfly.svg", "assets/enemies/butterfly.tvg", wide, cell, 2)
        Gfx.boss = Gfx_Sheet("assets/enemies/boss.svg", "assets/enemies/boss.tvg", wide, cell, 3)
        Gfx.scout = Gfx_Sheet("assets/enemies/scout.svg", "assets/enemies/scout.tvg", wide, cell, 4)
        Gfx.dart = Gfx_Sheet("assets/enemies/dart.svg", "assets/enemies/dart.tvg", wide, cell, 5)
        Gfx.heavy = Gfx_Sheet("assets/enemies/heavy.svg", "assets/enemies/heavy.tvg", wide, cell, 6)
        Gfx.flag = Gfx_Sheet("assets/enemies/flagship.svg", "assets/enemies/flagship.tvg", wide, cell, 7)
        Gfx.cap = Gfx_Sheet("assets/enemies/captor.svg", "assets/enemies/captor.tvg", wide, cell, 8)
        wide = Multiply(8, cell)
        Gfx.gate = Gfx_Sheet("assets/fx/portal.svg", "assets/fx/portal.tvg", wide, cell, 11)
        Gfx.pshot = Gfx_Sheet("assets/bullets/player.svg", "assets/bullets/player.tvg", cell, cell, 20)
        Gfx.eshot = Gfx_Sheet("assets/bullets/enemy.svg", "assets/bullets/enemy.tvg", cell, cell, 21)
        Gfx.boom0 = Gfx_Sheet("assets/explosions/burst.svg", "assets/explosions/burst.tvg", wide, cell, 10)
        Gfx.boom1 = Gfx_Sheet("assets/explosions/ring.svg", "assets/explosions/ring.tvg", wide, cell, 11)
        Gfx.boom2 = Gfx_Sheet("assets/explosions/debris.svg", "assets/explosions/debris.tvg", wide, cell, 12)
        Gfx.boom3 = Gfx_Sheet("assets/explosions/flash.svg", "assets/explosions/flash.tvg", wide, cell, 13)
        wide = Multiply(4, cell)
        Gfx.thrust = Gfx_Sheet("assets/ships/thrust.svg", 0, wide, cell, Subtract(0, 1))
        qc = Multiply(cell, 2)
        wide = Multiply(10, qc)
        Gfx.queen = Gfx_Sheet("assets/enemies/queen.svg", 0, wide, qc, Subtract(0, 1))
        wide = Multiply(5, cell)
        Gfx.part = Gfx_Sheet("assets/fx/parts.svg", 0, wide, cell, Subtract(0, 1))

        Gfx.cell = cell
        Gfx.ok = 1
        PrintMessage("[Gfx] cell=")
        PrintNumber(cell)
        PrintMessage(" window=")
        PrintNumber(World.fw)
        PrintMessage("x")
        PrintNumber(World.fh)
        PrintMessage("\n")
        ReturnValue(1)
    }
}

Function.Gfx_SurfFor {
    Input: kind: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(kind, Kind.PLAYER) ThenBlock: { ReturnValue(Gfx.player) }
        IfCondition EqualTo(kind, Kind.BEE) ThenBlock: { ReturnValue(Gfx.bee) }
        IfCondition EqualTo(kind, Kind.BUTTER) ThenBlock: { ReturnValue(Gfx.butter) }
        IfCondition EqualTo(kind, Kind.BOSS) ThenBlock: { ReturnValue(Gfx.boss) }
        IfCondition EqualTo(kind, Kind.SCOUT) ThenBlock: { ReturnValue(Gfx.scout) }
        IfCondition EqualTo(kind, Kind.DART) ThenBlock: { ReturnValue(Gfx.dart) }
        IfCondition EqualTo(kind, Kind.HEAVY) ThenBlock: { ReturnValue(Gfx.heavy) }
        IfCondition EqualTo(kind, Kind.FLAG) ThenBlock: { ReturnValue(Gfx.flag) }
        IfCondition EqualTo(kind, Kind.CAP) ThenBlock: { ReturnValue(Gfx.cap) }
        IfCondition EqualTo(kind, Kind.GATE) ThenBlock: { ReturnValue(Gfx.gate) }
        IfCondition EqualTo(kind, Kind.PBULLET) ThenBlock: { ReturnValue(Gfx.pshot) }
        IfCondition EqualTo(kind, Kind.EBULLET) ThenBlock: { ReturnValue(Gfx.eshot) }
        IfCondition EqualTo(kind, Kind.BOOM) ThenBlock: {
            st = Scratch.a
            IfCondition EqualTo(st, 1) ThenBlock: { ReturnValue(Gfx.boom1) }
            IfCondition EqualTo(st, 2) ThenBlock: { ReturnValue(Gfx.boom2) }
            IfCondition EqualTo(st, 3) ThenBlock: { ReturnValue(Gfx.boom3) }
            ReturnValue(Gfx.boom0)
        }
        ReturnValue(0)
    }
}

Function.Gfx_IsBug {
    Input: kind: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(kind, Kind.BEE) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(kind, Kind.BUTTER) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(kind, Kind.BOSS) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(kind, Kind.SCOUT) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(kind, Kind.DART) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(kind, Kind.HEAVY) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(kind, Kind.FLAG) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(kind, Kind.CAP) ThenBlock: { ReturnValue(1) }
        ReturnValue(0)
    }
}

Function.Gfx_FormNudge {
    Input: id: Integer
    Body: {
        Blit.nx = 0
        Blit.ny = 0
        st = Ent_Get(id, EField.ST)
        IfCondition NotEqual(st, Est.FORM) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(Form.ok, 1) ThenBlock: { ReturnValue(0) }
        slot = Ent_Get(id, EField.SLOT)
        IfCondition LessThan(slot, 0) ThenBlock: { ReturnValue(0) }
        IfCondition GreaterEqual(slot, Form.n) ThenBlock: { ReturnValue(0) }
        bx = Form.bobx
        by = Form.boby
        ux = Ent_Get(id, EField.X)
        uy = Ent_Get(id, EField.Y)
        sx = Subtract(ux, bx)
        sy = Subtract(uy, by)
        px = World_X(sx)
        du = World_DU(bx)
        px = Add(px, du)
        got = World_X(ux)
        Blit.nx = Subtract(px, got)
        py = World_Y(sy)
        du = World_DU(by)
        py = Add(py, du)
        got = World_Y(uy)
        Blit.ny = Subtract(py, got)
    }
}

Function.Gfx_DrawEnt {
    Input: id: Integer
    Body: {
        IfCondition EqualTo(Ent_Alive(id), 0) ThenBlock: { ReturnValue(0) }
        fl = Ent_Get(id, EField.FL)
        vis = BitwiseAnd(fl, EFlag.VIS)
        IfCondition EqualTo(vis, 0) ThenBlock: { ReturnValue(0) }
        kind = Ent_Get(id, EField.KIND)
        col = Ent_Get(id, EField.VIEW)
        IfCondition EqualTo(kind, Kind.GATE) ThenBlock: {
            col = Ent_Get(id, EField.FR)
        }
        IfCondition EqualTo(kind, Kind.BOOM) ThenBlock: {
            Scratch.a = Ent_Get(id, EField.ST)
            col = Ent_Get(id, EField.FR)
        }
        IfCondition EqualTo(kind, Kind.SHARD) ThenBlock: {
            Scratch.a = Ent_Get(id, EField.ST)
            col = Ent_Get(id, EField.FR)
            kind = Kind.BOOM
        }
        IfCondition EqualTo(kind, Kind.PBULLET) ThenBlock: { col = 0 }
        IfCondition EqualTo(kind, Kind.EBULLET) ThenBlock: { col = 0 }
        bug = Gfx_IsBug(kind)
        IfCondition EqualTo(bug, 1) ThenBlock: {
            st = Ent_Get(id, EField.ST)
            ph = Add(Arcade.t, Multiply(id, 5))
            step = 9
            IfCondition EqualTo(st, Est.DIVE) ThenBlock: { step = 3 }
            IfCondition EqualTo(st, Est.HUNT) ThenBlock: { step = 4 }
            IfCondition EqualTo(st, Est.BEAM) ThenBlock: { step = 3 }
            IfCondition EqualTo(st, Est.FLEE) ThenBlock: { step = 4 }
            IfCondition EqualTo(st, Est.ENTER) ThenBlock: { step = 6 }
            IfCondition EqualTo(st, Est.FORM) ThenBlock: {
                bit = Divide(ph, step)
                bit = Modulo(bit, 2)
                IfCondition EqualTo(bit, 1) ThenBlock: { col = View.BOTTOM }
            }
            Blit.glow = 0
            IfCondition NotEqual(st, Est.FORM) ThenBlock: {
                span = Multiply(step, 2)
                wave = Modulo(ph, span)
                IfCondition GreaterThan(wave, step) ThenBlock: {
                    wave = Subtract(span, wave)
                }
                hot = 28
                IfCondition EqualTo(st, Est.DIVE) ThenBlock: { hot = 56 }
                IfCondition EqualTo(st, Est.HUNT) ThenBlock: { hot = 48 }
                IfCondition EqualTo(st, Est.BEAM) ThenBlock: { hot = 64 }
                inc = Multiply(wave, 8)
                Blit.glow = Add(hot, inc)
            }
        }
        surf = Gfx_SurfFor(kind)
        flash = 0
        IfCondition EqualTo(kind, Kind.PLAYER) ThenBlock: {
            IfCondition GreaterThan(Arcade.inv, 0) ThenBlock: {
                IfCondition LessThan(Modulo(Arcade.t, 6), 3) ThenBlock: { flash = 1 }
            }
        }
        Gfx_FormNudge(id)
        IfCondition EqualTo(flash, 0) ThenBlock: {
            IfCondition EqualTo(kind, Kind.PLAYER) ThenBlock: {
                IfCondition EqualTo(col, View.TOP) ThenBlock: {
                    IfCondition NotEqual(Gfx.thrust, 0) ThenBlock: {
                        tf = Divide(Arcade.t, 3)
                        tf = Modulo(tf, 4)
                        Ent_Blit(id, Gfx.thrust, Gfx.cell, Gfx.cell, tf)
                    }
                }
            }
            Ent_Blit(id, surf, Gfx.cell, Gfx.cell, col)
            IfCondition EqualTo(kind, Kind.PLAYER) ThenBlock: {
                IfCondition EqualTo(Arcade.dual, 1) ThenBlock: {
                    ox = Ent_Get(id, EField.X)
                    Ent_Set(id, EField.X, Add(ox, 22))
                    IfCondition EqualTo(col, View.TOP) ThenBlock: {
                        IfCondition NotEqual(Gfx.thrust, 0) ThenBlock: {
                            tf = Divide(Arcade.t, 3)
                            tf = Modulo(tf, 4)
                            Ent_Blit(id, Gfx.thrust, Gfx.cell, Gfx.cell, tf)
                        }
                    }
                    Ent_Blit(id, surf, Gfx.cell, Gfx.cell, col)
                    Ent_Set(id, EField.X, ox)
                }
            }
        }
        IfCondition EqualTo(kind, Kind.CAP) ThenBlock: {
            held = Arcade.held
            IfCondition EqualTo(held, id) ThenBlock: {
                ox = Ent_Get(id, EField.X)
                oy = Ent_Get(id, EField.Y)
                Ent_Set(id, EField.Y, Add(oy, 56))
                Blit.nx = 0
                Blit.ny = 0
                Ent_Blit(id, Gfx.player, Gfx.cell, Gfx.cell, View.TOP)
                Ent_Set(id, EField.Y, oy)
            }
        }
        Blit.nx = 0
        Blit.ny = 0
    }
}
