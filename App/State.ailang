FixedPool.Scratch {
    "a": Initialize=0, CanChange=True
    "b": Initialize=0, CanChange=True
    "c": Initialize=0, CanChange=True
    "d": Initialize=0, CanChange=True
    "e": Initialize=0, CanChange=True
    "f": Initialize=0, CanChange=True
    "x": Initialize=0, CanChange=True
    "y": Initialize=0, CanChange=True
    "i": Initialize=0, CanChange=True
    "n": Initialize=0, CanChange=True
    "w": Initialize=0, CanChange=True
}

FixedPool.Rng {
    "s": Initialize=1, CanChange=True
}

Function.Arc_Seed {
    Input: seed: Integer
    Body: {
        IfCondition EqualTo(seed, 0) ThenBlock: { seed = 1 }
        Rng.s = BitwiseAnd(seed, 0x7FFFFFFF)
    }
}

Function.Arc_Rand {
    Output: Integer
    Body: {
        Rng.s = BitwiseAnd(Add(Multiply(Rng.s, 1664525), 1013904223), 0x7FFFFFFF)
        ReturnValue(Rng.s)
    }
}

Function.Arc_Range {
    Input: n: Integer
    Output: Integer
    Body: {
        IfCondition LessEqual(n, 1) ThenBlock: { ReturnValue(0) }
        ReturnValue(Modulo(Arc_Rand(), n))
    }
}

Function.Arc_RGBA {
    Input: r: Integer
    Input: g: Integer
    Input: b: Integer
    Output: Integer
    Body: {
        ReturnValue(BitwiseOr(FB_RGB(r, g, b), ShiftLeft(255, 24)))
    }
}

Function.Arc_LE32 {
    Input: buf: Address
    Input: off: Integer
    Input: val: Integer
    Body: {
        SetByte(buf, off, BitwiseAnd(val, 255))
        SetByte(buf, Add(off, 1), BitwiseAnd(ShiftRight(val, 8), 255))
        SetByte(buf, Add(off, 2), BitwiseAnd(ShiftRight(val, 16), 255))
        SetByte(buf, Add(off, 3), BitwiseAnd(ShiftRight(val, 24), 255))
    }
}

Function.Arc_Atoi {
    Input: s: Address
    Output: Integer
    Body: {
        Scratch.x = 0
        Scratch.w = 0
        Scratch.n = 0
        WhileLoop LessThan(Scratch.x, 96) {
            Scratch.c = GetByte(s, Scratch.x)
            IfCondition EqualTo(Scratch.c, 0) ThenBlock: {
                ReturnValue(Scratch.w)
            }
            IfCondition EqualTo(Scratch.c, 10) ThenBlock: {
                ReturnValue(Scratch.w)
            }
            IfCondition And(GreaterEqual(Scratch.c, 48), LessEqual(Scratch.c, 57)) ThenBlock: {
                Scratch.w = Add(Multiply(Scratch.w, 10), Subtract(Scratch.c, 48))
                Scratch.n = 1
            }
            IfCondition And(EqualTo(Scratch.c, 32), EqualTo(Scratch.n, 1)) ThenBlock: {
                ReturnValue(Scratch.w)
            }
            Scratch.x = Add(Scratch.x, 1)
        }
        ReturnValue(Scratch.w)
    }
}
